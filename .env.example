# Optional local development settings. The fixed account is configured on the server.
RECIPE_PORT=4173

# EdgeOne server-side settings. Local development continues to use FileStore.
# Create the table with scripts/setup-supabase.sql, then set these in EdgeOne.
# FENGWEI_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# FENGWEI_SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# FENGWEI_ACCOUNT_NAMESPACE=fengwei-recipes

# Resend: required for verified registration and email password recovery.
# Use a sender on your verified domain; configure these only on the server.
# See EMAIL-SETUP.md. Never put a real key in Git or frontend code.
# FENGWEI_RESEND_API_KEY=re_YOUR_SENDING_KEY
# FENGWEI_EMAIL_FROM="峰味 <noreply@mail.your-domain.com>"
