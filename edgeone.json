{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "artifacts/fengwei-edgeone",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "schedules": [
    {
      "name": "fengwei-audit-retention",
      "cron": "15 3 * * *",
      "path": "/api/maintenance/audit",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    }
  ]
}
